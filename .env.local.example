# Local Postgres from docker-compose.yml. Never point this at a remote database
# while running scripts/db-reset.mjs — it drops the public schema.
DATABASE_URL=postgres://billyai:billyai@localhost:54331/billyai

# Small on serverless: one instance serves one request, and Supavisor is doing
# the real pooling. Leave unset locally.
# DB_POOL_MAX=2

# 32 random bytes, base64. Encrypts PromptPay mobile numbers at rest (D12).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PROMPTPAY_KEY=

# Messaging API channel secret from the LINE Developers Console. The webhook
# verifies X-Line-Signature against it, so a wrong value rejects every event.
LINE_CHANNEL_SECRET=

# Long-lived channel access token from the **Messaging API** tab of the LINE
# Developers Console. This is NOT the channel secret above, which lives on the
# Basic settings tab. Without it the bot can verify webhooks but cannot answer.
LINE_CHANNEL_ACCESS_TOKEN=

# LIFF app id (looks like 1234567890-abcdefgh). Public by design: it is baked
# into the client bundle at build time, which is why it carries no secret.
NEXT_PUBLIC_LIFF_ID=
