# Local Postgres from docker-compose.yml. Never point this at a remote database
# while running scripts/db-reset.mjs — it drops the public schema.
DATABASE_URL=postgres://billyai:billyai@localhost:54331/billyai

# Small on serverless: one instance serves one request, and Supavisor is doing
# the real pooling. Leave unset locally.
# DB_POOL_MAX=2

# 32 random bytes, base64. Encrypts PromptPay mobile numbers at rest (D12).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PROMPTPAY_KEY=
